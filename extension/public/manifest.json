{
  "manifest_version": 3,
  "name": "TabTerm",
  "version": "0.0.0",
  "description": "Local terminal sessions that behave like native Chrome tabs",
  "minimum_chrome_version": "120",
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "permissions": ["offscreen", "storage"],
  "icons": {}
}
