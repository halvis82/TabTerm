{
  "manifest_version": 3,
  "name": "TabTerm",
  "version": "0.0.0",
  "description": "Local terminal sessions that behave like native Chrome tabs",
  "minimum_chrome_version": "120",
  "key": "",
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": ["offscreen", "storage", "tabs", "tabGroups", "nativeMessaging"],
  "icons": {},
  "action": {
    "default_title": "New terminal"
  },
  "commands": {
    "new-terminal": {
      "suggested_key": {
        "mac": "Command+Shift+E"
      },
      "description": "Open a new terminal tab"
    }
  }
}
