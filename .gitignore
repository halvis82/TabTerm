# Build output
dist/
dist-types/
build/
*.tsbuildinfo

# Dependencies
node_modules/

# Runtime state (never in the repo)
state/
logs/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Secrets (never in the repo, ever)
*.pem
*.key
extension-key.*
token

# Local personal plugins
plugins/*
!plugins/.gitkeep

# macOS
.DS_Store
# iCloud Drive makes these when it resolves a sync conflict, and a home directory under
# Documents is synced by default. They are stale copies of tracked files.
* 2.*
* [0-9].*
