<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tabterm.daemon</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__LIBEXEC__/daemon.mjs</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <!-- Restart on crash, but let `tabterm stop` actually stop it. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <!-- Keeps macOS from aggressively throttling a process users are waiting on. -->
  <key>ProcessType</key>
  <string>Interactive</string>

  <key>StandardOutPath</key>
  <string>__STATE__/logs/stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__STATE__/logs/stderr.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
  </dict>
</dict>
</plist>
